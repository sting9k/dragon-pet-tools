# Copy this file to .env and fill it in. .env is git-ignored: never commit it, never print it.
# A variable already set in the shell wins over the value here.
# Any image service with an OpenAI-style API (.../v1/images/edits) works; none is built in.

# redraw of the pet body (gen_pet.py, pet.py reskin): form upload, must keep the shape of the reference
RESKIN_KEY=
RESKIN_API=https://your-image-service.example/v1/images/edits
#RESKIN_MODEL=qwen-image-3.0-pro

# skill effects (sprite-forge image_api.py, pet.py fx --draw)
IMAGE_KEY=
IMAGE_API=https://your-image-service.example/v1/images/edits
#IMAGE_MODEL=gpt-image-2
#IMAGE_API_STYLE=json

# folder that holds pack/ and generated/ (default: ../../assets from this folder)
#ASSETS_DIR=
# Chrome or Chromium binary, when it is not found on its own
#CHROME=
